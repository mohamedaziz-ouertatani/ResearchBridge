DATABASE_URL=postgresql+psycopg://researchbridge:researchbridge@localhost:5433/researchbridge

# Register at https://dev.springernature.com to get these
SPRINGER_META_API_KEY=
SPRINGER_OPEN_ACCESS_API_KEY=

# Optional - the Semantic Scholar connector runs unauthenticated by default
# (same as arXiv). Register at https://www.semanticscholar.org/product/api
# to raise the rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Required for the CORE connector - register at https://core.ac.uk/services/api
CORE_API_KEY=

# Optional - powers real patent-search results in the "external validation"
# assessment section (Tunisia-scoped). Register a free consumer key/secret
# at https://developers.epo.org. If unset, that section falls back to its
# "patent search unavailable" disclaimer wording - the rest of the
# assessment is unaffected.
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Optional - used by `rb-citations-fetch --source crossref`. CrossRef's API
# is open with no key, but including a contact email as `mailto` puts
# requests in CrossRef's "polite pool" (higher, steadier rate limits).
CROSSREF_MAILTO=

# Optional local-LLM stages: Q&A summarization, application-relevance
# filtering, and product-opportunity synthesis. On by default (2026-09-05)
# - every stage that uses this fails safe to a deterministic result (never a
# crash or fabricated output) if Ollama isn't actually reachable, so this
# just means those stages attempt to enrich results, falling back cleanly
# when there's no Ollama server. Requires a running Ollama server
# (https://ollama.com) with OLLAMA_MODEL pulled, e.g. `ollama pull qwen2.5:3b`,
# to actually take effect. Set to false to skip these stages entirely
# (e.g. no Ollama installed - avoids paying the connection-timeout cost).
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30

