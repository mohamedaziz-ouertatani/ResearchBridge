DATABASE_URL=postgresql+psycopg://researchbridge:researchbridge@localhost:5433/researchbridge

# Register at https://dev.springernature.com to get these
SPRINGER_META_API_KEY=
SPRINGER_OPEN_ACCESS_API_KEY=

# Optional - the Semantic Scholar connector runs unauthenticated by default
# (same as arXiv). Register at https://www.semanticscholar.org/product/api
# to raise the rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Optional - local-LLM summarization layer on top of the extractive /api/ask
# results. Off by default. Requires a running Ollama server
# (https://ollama.com) with OLLAMA_MODEL pulled, e.g. `ollama pull qwen2.5:3b`.
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30

